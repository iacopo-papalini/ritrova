# Copy to .env on the server and fill in. compose refuses to start without
# POSTGRES_PASSWORD and PHOTOS_DIR.

POSTGRES_PASSWORD=
POSTGRES_USER=ritrova
POSTGRES_DB=ritrova

# The photo tree, bind-mounted read-only. On paiolo this is the destination of
# the half-hourly pull-only rclone sync; see the warning in compose.yaml before
# considering making it writable.
PHOTOS_DIR=/srv/family-data/Nextcloud

# Must match the OWNER of PHOTOS_DIR. On paiolo the tree root is mode 0700, so
# the UID has to be exactly right — a matching group alone gets no traversal.
#   stat -c '%u %g' /srv/family-data/Nextcloud   -> 1000 1000
RITROVA_UID=1000
RITROVA_GID=1000

# Interfaces to publish on. The app is deliberately LAN-wide; Postgres can be
# narrowed to just the Mac that runs `ritrova analyse`.
RITROVA_BIND=0.0.0.0
POSTGRES_BIND=0.0.0.0
