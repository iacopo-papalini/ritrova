# Copy to .env on the server and fill in. compose refuses to start without
# POSTGRES_PASSWORD and PHOTOS_DIR.

POSTGRES_PASSWORD=
POSTGRES_USER=ritrova
POSTGRES_DB=ritrova

# The photo tree, bind-mounted read-only. Stored paths are relative to THIS
# directory, so it is the folder holding the year directories — not the sync
# root above it. Point it one level too high and every page renders while
# every image 404s.
#
# On paiolo it is also reached through a bind mount: docker is the Canonical
# snap, whose confinement sees only $HOME, so /srv is invisible to the daemon
# and `mount --bind /srv/family-data/Nextcloud /home/iacopo/photos` (ro, in
# fstab) is what makes the archive reachable at all.
PHOTOS_DIR=/home/iacopo/photos/Photos

# Must match the OWNER of PHOTOS_DIR. On paiolo the tree root is mode 0700, so
# the UID has to be exactly right — a matching group alone gets no traversal.
#   stat -c '%u %g' /srv/family-data/Nextcloud   -> 1000 1000
RITROVA_UID=1000
RITROVA_GID=1000

# Interfaces to publish on. The app is deliberately LAN-wide; Postgres can be
# narrowed to just the Mac that runs `ritrova analyse`.
RITROVA_BIND=0.0.0.0
POSTGRES_BIND=0.0.0.0
